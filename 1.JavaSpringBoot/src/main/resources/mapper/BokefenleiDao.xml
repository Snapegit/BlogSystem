<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.BokefenleiDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.BokefenleiEntity" id="bokefenleiMap">
        <result property="bokefenlei" column="bokefenlei"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.BokefenleiView" >

		SELECT  bokefenlei.* FROM bokefenlei  bokefenlei 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.BokefenleiView" >
		SELECT * FROM bokefenlei  bokefenlei <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
